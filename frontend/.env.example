# ThreatNeXus frontend — environment variables.
#
# IMPORTANT: every VITE_-prefixed variable is INLINED into the JavaScript bundle
# that is served to the browser. Nothing secret may ever appear here. Provider
# API keys are read exclusively by the backend, and CI fails the build if a
# secret-shaped literal reaches the bundle.

# Base URL of the backend API, including the /api prefix the server mounts on.
VITE_API_BASE_URL=http://localhost:5000/api

# Display only.
VITE_APP_NAME=ThreatNeXus
VITE_ENV=development
