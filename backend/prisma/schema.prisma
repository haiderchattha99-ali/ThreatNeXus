generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ANALYST
  REVIEWER
  VIEWER
}

enum TlpLabel {
  CLEAR
  GREEN
  AMBER
  AMBER_STRICT
  RED
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(VIEWER)
  createdAt DateTime @default(now())

  // Phase 1 — virtual back-relations only (no columns on User). The foreign
  // keys live on RawReport.ingestedByUserId and Finding.closedByUserId, both
  // nullable with onDelete: SetNull so deleting a user never destroys evidence
  // or a finding — the actor reference is nulled instead.
  ingestedReports RawReport[] @relation("RawReportIngestedBy")
  closedFindings  Finding[]   @relation("FindingClosedBy")

  // Phase 2 (P2-T1) — same SetNull-actor-reference convention: deleting a
  // user must never destroy an AssetMapping or a FindingOwnership history
  // row, only null the actor attribution.
  assetMappingsCreated AssetMapping[]     @relation("AssetMappingCreatedBy")
  assetMappingsUpdated AssetMapping[]     @relation("AssetMappingUpdatedBy")
  ownershipOverrides   FindingOwnership[] @relation("OwnershipOverrideActor")

  // Phase 2 (P2-T3) — same SetNull-actor-reference convention. Only a MANUAL
  // recalculation carries an actor; automatic triggers leave actorUserId null.
  riskCalculations RiskScore[] @relation("RiskScoreActor")

  // Phase 2 (§2B) — same SetNull-actor convention. Every CVE association is
  // an explicit human act and always carries an actor at write time; the
  // column is nullable only so deleting a user cannot destroy the history.
  vulnerabilityAssociations FindingVulnerability[]       @relation("FindingVulnerabilityActor")
  vulnerabilityJobs         VulnerabilityEnrichmentJob[] @relation("VulnerabilityJobActor")

  // Phase 3 — same SetNull-actor convention throughout. Every analyst-workflow
  // act (triage, link, lifecycle transition, organization response, closure
  // request, closure review) always carries an actor at write time; the
  // columns are nullable only so deleting a User nulls the attribution instead
  // of destroying the defensible history that justifies a closure.
  triageDecisions        FindingTriage[]            @relation("FindingTriageActor")
  casesCreated           Case[]                     @relation("CaseCreatedBy")
  casesClosed            Case[]                     @relation("CaseClosedBy")
  caseFindingLinks       CaseFinding[]              @relation("CaseFindingActor")
  caseLifecycleEvents    CaseLifecycleEvent[]       @relation("CaseLifecycleActor")
  caseResponsesRecorded  CaseOrganizationResponse[] @relation("CaseResponseRecordedBy")
  closureRequestsMade    CaseClosureRequest[]       @relation("CaseClosureRequestedBy")
  closureRequestsDecided CaseClosureRequest[]       @relation("CaseClosureReviewedBy")
}

model Threat {
  id        Int      @id @default(autoincrement())
  ip        String?
  domain    String?
  hash      String?
  severity  String
  source    String
  riskScore Int
  status    String
  iocType   String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id          Int          @id @default(autoincrement())
  occurredAt  DateTime     @default(now())
  action      String
  outcome     AuditOutcome
  actorUserId String?
  actorEmail  String?
  actorRole   Role?
  sourceIp    String?
  requestId   String?
  method      String?
  path        String?
  entityType  String?
  entityId    String?
  before      Json?
  after       Json?
  tlp         TlpLabel     @default(AMBER)
  reason      String?

  @@index([occurredAt])
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([action])
}

// EXTENDED in Phase 3 (analyst workflow) — every Phase 3 column is additive
// and nullable or defaulted, so every pre-existing row stays valid without a
// data migration and the legacy free-text `organization`/`status`/`analyst`
// columns keep working exactly as before.
//
// Two status concepts now coexist deliberately and are NOT merged:
//   - `status`         — the legacy free-text label the Phase 0 UI writes
//                        ("Open"/"Investigating"/"Resolved"/"Closed"). Kept
//                        for backwards compatibility; never authoritative.
//   - `lifecycleState` — the Phase 3 enum the defensible workflow is driven
//                        by. Every transition of THIS column is guarded and
//                        writes an immutable CaseLifecycleEvent.
// Collapsing them would silently let a free-text UI edit close a case without
// reviewer approval, which is exactly what Phase 3 exists to prevent.
model Case {
  id           Int      @id @default(autoincrement())
  title        String
  threatType   String
  organization String
  priority     String   @default("Medium")
  status       String   @default("Open")
  analyst      String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // --- Phase 3: organization binding -------------------------------------
  // Server-generated, human-readable, globally unique ("TNX-2026-000042").
  // Nullable only because rows created before Phase 3 have none; every case
  // created from now on receives one inside the creation transaction.
  caseReference String? @unique

  // A Phase 3 case belongs to exactly ONE Organization. Restrict: an
  // organization that owns case history must never be deleted out from under
  // it. Null means a legacy, non-organization-bound case — such a case is
  // readable but every Phase 3 workflow operation refuses it.
  // Named `ownerOrganization` rather than `organization` because the legacy
  // free-text `organization` String column already owns that name and must be
  // preserved verbatim for backwards compatibility.
  organizationId    Int?
  ownerOrganization Organization? @relation("CaseOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  // --- Phase 3: authoritative lifecycle ----------------------------------
  lifecycleState CaseLifecycleState @default(OPEN)

  createdByUserId Int?
  createdBy       User? @relation("CaseCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Current-closure projection. These describe the case's CURRENT closure and
  // are cleared on reopen — the permanent record of every closure lives in
  // CaseLifecycleEvent + CaseClosureRequest, never only here.
  closedAt       DateTime?
  closureReason  CaseClosureReason?
  closedByUserId Int?
  closedBy       User?              @relation("CaseClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)

  // Reopen projection, same rule: evidence lives in CaseLifecycleEvent and
  // CaseRecurrenceReopen; these exist so a list view can badge a case without
  // joining history.
  lastReopenedAt    DateTime?
  lastReopenTrigger CaseReopenTrigger?
  reopenedCount     Int                @default(0)

  findingLinks          CaseFinding[]
  lifecycleEvents       CaseLifecycleEvent[]
  organizationResponses CaseOrganizationResponse[]
  closureRequests       CaseClosureRequest[]
  recurrenceReopens     CaseRecurrenceReopen[]
  triageDecisions       FindingTriage[]            @relation("FindingTriageCase")

  @@index([lifecycleState])
  @@index([organizationId, lifecycleState])
}

model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  severity  String   @default("Low")
  status    String   @default("Unread")
  type      String   @default("System")
  createdAt DateTime @default(now())
}

model Organization {
  id            Int                @id @default(autoincrement())
  name          String
  industry      String
  location      String
  contactPerson String
  email         String             @unique
  phone         String?
  securityScore Int                @default(100)
  activeThreats Int                @default(0)
  // P2-T1 — additive. Defaults to UNKNOWN so every pre-existing row stays
  // valid without a data migration; a criticality signal for future risk
  // scoring, never itself a risk score.
  sector        OrganizationSector @default(UNKNOWN)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  assetMappings     AssetMapping[]
  findingOwnerships FindingOwnership[]

  // Phase 3 — an organization-bound case and the ownership snapshot each link
  // was accepted under. Both FKs are Restrict: an Organization that owns case
  // or link history must never be deleted out from under that history.
  cases            Case[]        @relation("CaseOrganization")
  caseFindingLinks CaseFinding[] @relation("CaseFindingOrganization")
}

// ===========================================================================
// Phase 1 — Ingestion & finding lifecycle (P1-T1 schema foundation).
//
// Additive only. These models introduce the RawReport -> RawReportRow evidence
// chain and the deduplicated Finding -> FindingOccurrence lifecycle. They do
// not touch, link to, or replace the legacy Threat model, nor Case /
// Notification / Organization. No routes, controllers, parsers or services are
// implemented here — this is the schema/migration foundation only.
// ===========================================================================

// One report type for the whole MVP. A ReportSchema/registry model is
// deliberately NOT introduced yet — it is premature for a single type.
enum ReportType {
  ACCESSIBLE_RDP
}

// Enum, not free text: the transport protocol is part of the Finding identity
// key, so "tcp"/"TCP"/"Tcp" must never fracture deduplication. Phase 1
// synthetic v1 is tcp-only; further values are an additive change later.
enum TransportProtocol {
  TCP
}

// RawReport processing lifecycle. REJECTED = structurally not the expected
// report (e.g. required columns absent); FAILED = unexpected processing error;
// PARTIALLY_VALID = the normal path when some rows are invalid.
enum RawReportStatus {
  RECEIVED
  PROCESSING
  COMPLETED
  PARTIALLY_VALID
  FAILED
  REJECTED
}

// Per-row validation outcome. Invalid rows are preserved as evidence, never
// dropped — this distinguishes them from valid ones without a free-text field.
enum RawReportRowStatus {
  VALID
  INVALID
}

// Finding lifecycle. Findings are closed manually only; absence never closes a
// finding automatically. A later observation reopens a CLOSED finding only when
// the service layer confirms it post-dates closedThroughObservedAt.
enum FindingStatus {
  OPEN
  CLOSED
}

// Immutable per-(finding, report) lifecycle action.
// HISTORICAL = an out-of-order earlier observation that must not reopen a
// closed finding but is still recorded as evidence.
enum FindingOccurrenceAction {
  CREATED
  PERSISTED
  RECURRED
  HISTORICAL
}

// Immutable evidence: the original uploaded report file, preserved verbatim.
// Identity is the server-computed SHA-256 of the exact file bytes (globally
// unique), which is what lets a re-upload of identical bytes be recognised as
// the same report (idempotent retry / concurrent-duplicate protection) rather
// than creating a second evidence record.
model RawReport {
  id                 Int             @id @default(autoincrement())
  reportType         ReportType
  schemaVersion      String
  sourceFileName     String
  sourceFileSha256   String          @unique
  fileSizeBytes      Int
  contentType        String
  rawContent         Bytes
  observationDate    DateTime
  ingestedAt         DateTime        @default(now())
  ingestedByUserId   Int?
  ingestedBy         User?           @relation("RawReportIngestedBy", fields: [ingestedByUserId], references: [id], onDelete: SetNull)
  tlp                TlpLabel        @default(AMBER)
  status             RawReportStatus @default(RECEIVED)
  totalRows          Int             @default(0)
  validRows          Int             @default(0)
  invalidRows        Int             @default(0)
  errorSummary       Json?
  processingAttempts Int             @default(0)
  completedAt        DateTime?

  rows        RawReportRow[]
  occurrences FindingOccurrence[]

  @@index([reportType, ingestedAt])
  @@index([status])
}

// Immutable evidence: every parsed row, including invalid and within-report
// duplicate rows. rawPayload is the row exactly as parsed; normalizedPayload is
// populated once normalization runs. A row references at most one
// FindingOccurrence (many rows may point at the same occurrence).
model RawReportRow {
  id                  Int                @id @default(autoincrement())
  rawReportId         Int
  rawReport           RawReport          @relation(fields: [rawReportId], references: [id], onDelete: Restrict)
  rowNumber           Int
  rawPayload          Json
  normalizedPayload   Json?
  status              RawReportRowStatus
  validationErrors    Json?
  duplicateInReport   Boolean            @default(false)
  findingOccurrenceId Int?
  findingOccurrence   FindingOccurrence? @relation(fields: [findingOccurrenceId], references: [id], onDelete: SetNull)
  createdAt           DateTime           @default(now())

  // Unique row number within a report. The composite also serves lookups by
  // rawReportId (leftmost prefix), so no separate rawReportId index is added.
  @@unique([rawReportId, rowNumber])
  @@index([findingOccurrenceId])
}

// The deduplicated spine. Identity is (indicatorValue, port, protocol,
// reportType), enforced by a composite unique constraint — this IS the locked
// dedup key. firstSeen/lastSeen/occurrenceCount/recurrenceCount are mutable
// deterministic projections re-derivable from FindingOccurrence, not evidence.
model Finding {
  id                      Int               @id @default(autoincrement())
  indicatorValue          String
  port                    Int
  protocol                TransportProtocol
  reportType              ReportType
  status                  FindingStatus     @default(OPEN)
  firstSeen               DateTime
  lastSeen                DateTime
  occurrenceCount         Int               @default(0)
  recurrenceCount         Int               @default(0)
  closedAt                DateTime?
  closedByUserId          Int?
  closedBy                User?             @relation("FindingClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closureReason           String?
  closedThroughObservedAt DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  occurrences FindingOccurrence[]

  // Phase 2 (P2-T1) — append-only ownership-resolution history. Restrict:
  // ownership history is evidence and must never be orphaned by deleting the
  // Finding it describes (Findings are never hard-deleted in this system).
  ownershipHistory FindingOwnership[]

  // Phase 2 (P2-T3) — append-only deterministic risk history, same Restrict
  // reasoning: a score and its factor contributions are the audit-grade
  // record of why this Finding was prioritised and must never be orphaned.
  riskScores RiskScore[]

  // Phase 2 (§2B) — append-only analyst-verified CVE association history.
  // Restrict, same reasoning: "an analyst asserted this host is affected by
  // CVE-X, and why" is evidence, not a cache.
  vulnerabilityAssociations FindingVulnerability[]

  // Phase 3 — append-only analyst triage history and append-only case-link
  // history. Restrict, for the same reason as every other Phase 1/2 history
  // table hanging off Finding: "an analyst decided this was escalated /
  // dismissed, and why" and "this Finding was the evidence in that case" are
  // the record that makes a closure defensible, and must never be orphaned.
  triageHistory FindingTriage[]
  caseLinks     CaseFinding[]

  // Phase 3 — the recurrence-driven reopen ledger keyed on this Finding.
  caseRecurrenceReopens CaseRecurrenceReopen[]

  // The locked identity key. Its index also covers indicatorValue-prefixed
  // lookups, so no separate indicatorValue index is added.
  @@unique([indicatorValue, port, protocol, reportType], name: "finding_identity")
  @@index([status])
  @@index([lastSeen])
}

// Immutable lifecycle evidence: exactly one record per (finding, report),
// recording what the ingestion of that report did to the finding and the
// report's observation time. Never updated or deleted.
model FindingOccurrence {
  id          Int                     @id @default(autoincrement())
  findingId   Int
  finding     Finding                 @relation(fields: [findingId], references: [id], onDelete: Restrict)
  rawReportId Int
  rawReport   RawReport               @relation(fields: [rawReportId], references: [id], onDelete: Restrict)
  observedAt  DateTime
  action      FindingOccurrenceAction
  createdAt   DateTime                @default(now())

  rows RawReportRow[]

  // Phase 3 — the recurrence-driven case-reopen ledger keyed on this exact
  // occurrence (see CaseRecurrenceReopen). Restrict: the reopen decision is
  // only defensible while the occurrence that caused it still exists.
  caseRecurrenceReopens CaseRecurrenceReopen[]

  // One lifecycle occurrence per finding per report. The composite covers
  // findingId-prefixed lookups; rawReportId needs its own index.
  @@unique([findingId, rawReportId])
  @@index([rawReportId])
}

// ===========================================================================
// Phase 2 (P2-T1) — Ownership mapping foundation.
//
// Additive only. Extends Organization with `sector` (default UNKNOWN, no
// existing row invalidated) and introduces AssetMapping (the registry of
// IP/CIDR/ASN -> Organization claims) and FindingOwnership (append-only
// resolution history for each Finding). No column on any Phase 0/1 model is
// altered or removed; no Threat/Case/Notification model is touched.
//
// Out of scope here (later Phase 2 tasks): IOC/vulnerability enrichment, risk
// scoring. This packet is ownership mapping and resolution only.
// ===========================================================================

// Sector/criticality classification of an Organization. A controlled enum
// rather than a separate Sector entity/table — the approved Phase 2 decision
// (DECISIONS.md) is that sector is a bounded, code-owned classification, not
// an open registry an analyst can grow arbitrarily. UNKNOWN is the safe
// default for every organization that predates this column.
enum OrganizationSector {
  CRITICAL_NATIONAL_INFRASTRUCTURE
  GOVERNMENT
  HEALTHCARE
  FINANCE
  ENERGY
  TELECOM
  EDUCATION
  GENERAL
  UNKNOWN
}

// What kind of indicator an AssetMapping row claims ownership over. Exactly
// one of exactIp / (cidr + prefixLength + ipStart/ipEnd) / asn is populated,
// matching this value — enforced at the service boundary, not by the
// database (Prisma/Postgres cannot express a portable partial-field CHECK
// here without raw SQL, which is out of scope for this task).
enum AssetMappingType {
  EXACT_IP
  CIDR
  ASN
}

// Provenance of an AssetMapping row. ANALYST_OVERRIDE is used where an
// override materializes as a mapping-shaped record in listings; the
// authoritative override state itself lives on FindingOwnership, not here.
enum AssetMappingSource {
  MANUAL
  IMPORTED_RIR
  ANALYST_OVERRIDE
}

// Honesty label on how sure an ownership resolution is. ASN attribution is
// always LOW (it identifies an ISP/upstream, not the constituent) — never
// upgraded regardless of how the ASN mapping itself was sourced.
enum OwnershipConfidence {
  CONFIRMED
  HIGH
  MEDIUM
  LOW
}

// Outcome of one ownership resolution attempt for a Finding.
enum OwnershipResolutionStatus {
  RESOLVED
  AMBIGUOUS
  UNRESOLVED
  OVERRIDDEN
}

// The registry of ownership claims: IP-exact, CIDR-range or ASN rows, each
// pointing at one Organization. Never hard-deleted — disable via `enabled`
// instead, so history that already resolved against a mapping stays
// explicable (`matchedMappingId` on FindingOwnership keeps meaning even after
// the mapping is later disabled).
model AssetMapping {
  id             Int              @id @default(autoincrement())
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  mappingType    AssetMappingType

  // Populated only for mappingType EXACT_IP — canonical dotted-quad display
  // value. Service-layer-enforced, not a DB CHECK (see AssetMappingType).
  exactIp String?

  // Populated only for mappingType CIDR — canonical "a.b.c.d/n" display
  // value plus its decomposed prefix length.
  cidr         String?
  prefixLength Int?

  // Populated for EXACT_IP (ipStart == ipEnd) and CIDR (the full range).
  // Unsigned-IPv4-as-BigInt so range containment is a plain numeric
  // comparison — never a signed 32-bit trap, never parsed per lookup.
  // Serialized back to dotted-quad/CIDR strings at the API boundary; never
  // returned as a raw BigInt (see ipv4Cidr.js / ownership API responses).
  ipStart BigInt?
  ipEnd   BigInt?

  // Populated only for mappingType ASN.
  asn Int?

  confidence OwnershipConfidence
  source     AssetMappingSource

  // Bounded at the service layer (see assetMappingService.js) — analyst free
  // text, never evidence, never echoed into a log/audit unbounded.
  provenanceNote String?

  mappingConfirmed Boolean @default(false)
  enabled          Boolean @default(true)

  // Optional validity window. A mapping with both null is valid indefinitely
  // once enabled. validUntil must not precede validFrom (service-enforced).
  validFrom  DateTime?
  validUntil DateTime?

  createdByUserId Int?
  createdBy       User? @relation("AssetMappingCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedByUserId Int?
  updatedBy       User? @relation("AssetMappingUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownershipMatches FindingOwnership[] @relation("MatchedMapping")

  @@index([organizationId])
  @@index([mappingType, enabled])
  @@index([asn])
  @@index([ipStart, ipEnd])
}

// Append-only ownership-resolution history for a Finding. Every resolution
// attempt — automatic (ingestion/mapping-change re-resolution) or an analyst
// override apply/clear — inserts a new row; existing rows are NEVER updated
// or deleted (only `supersededAt`/`currentForFindingId` change on the row
// being superseded, in the same transaction that inserts its replacement).
//
// Current-row invariant: at most one row per Finding is "current". A current
// row has currentForFindingId == findingId; every superseded row has it set
// back to null. Because Prisma/Postgres treat multiple NULLs in a unique
// column as distinct, a plain `@unique` column expresses "at most one current
// row per Finding" with no raw SQL and no partial index — see
// findingOwnershipService.js for the transactional supersede-then-insert.
model FindingOwnership {
  id        Int     @id @default(autoincrement())
  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  // Null only for UNRESOLVED (and, transiently, an AMBIGUOUS result with more
  // than one candidate organization).
  organizationId Int?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  status OwnershipResolutionStatus

  // Null for UNRESOLVED/AMBIGUOUS (there is no single confidence to report).
  confidence OwnershipConfidence?

  matchedMappingId    Int?
  matchedMapping      AssetMapping? @relation("MatchedMapping", fields: [matchedMappingId], references: [id], onDelete: Restrict)
  matchedPrefixLength Int?

  // How many distinct-organization candidates were found at the winning
  // tier. 0 for UNRESOLVED, 1 for RESOLVED/OVERRIDDEN, >1 for AMBIGUOUS.
  candidateCount Int @default(0)

  // True only when this result came from an ASN mapping — the "this is only
  // an ISP, not the constituent" honesty flag from BUILD_PLAN.md.
  isIspAttribution Boolean @default(false)

  // Stable machine-readable reason (OWNERSHIP_UNSUPPORTED_INDICATOR,
  // OWNERSHIP_NO_MATCH, OWNERSHIP_AMBIGUOUS_EXACT_IP, etc.) — see
  // ownershipResolver.js REASON_CODES. Never free text.
  reasonCode String

  resolvedAt DateTime @default(now())
  // The point in time resolution was evaluated against mapping validity
  // windows — normally resolvedAt, but kept distinct so a future replay can
  // resolve "as of" an arbitrary time without conflating the two concepts.
  asOf       DateTime

  supersededAt        DateTime?
  currentForFindingId Int?      @unique

  // Analyst-override provenance. Populated only when status == OVERRIDDEN
  // (apply) or when this row records an override being cleared.
  overrideActorUserId   Int?
  overrideActor         User?   @relation("OwnershipOverrideActor", fields: [overrideActorUserId], references: [id], onDelete: SetNull)
  overrideJustification String?

  createdAt DateTime @default(now())

  @@index([findingId])
  @@index([status])
  @@index([organizationId])
}

// ===========================================================================
// Phase 2 (P2-T2b) — IOC reputation enrichment: durable cache + work queue.
//
// Additive only. Introduces IocEnrichment plus two enums. No column on any
// Phase 0/1/P2-T1 model is altered, and this model deliberately has NO
// relation to Finding (see "Cache identity" below) — nothing in the existing
// evidence chain gains a new foreign key, so no existing real-database
// cleanup path changes.
//
// Out of scope here (P2-T2c and later): the AbuseIPDBProvider HTTP client,
// TTL policy defaults, ingestion wiring, routes/controllers, audit events.
// This packet is the persistence layer only.
//
// ---------------------------------------------------------------------------
// Cache identity is indicator-level, never Finding-level or report-level
// ---------------------------------------------------------------------------
// One reputation lookup answers a question about an *address*, not about a
// Finding. Ten Findings on the same IP must share one lookup and one TTL, so
// identity is (provider, indicatorType, indicator, normalized queryParams),
// collapsed into the deterministic `cacheKey` (see enrichmentCacheKey.js). A
// `findingId` FK would silently force one cache row per Finding, re-querying
// the provider once per Finding and burning quota — so it is deliberately
// absent. Whichever Finding motivated a lookup is a caller-side concern that
// belongs to the P2-T2c orchestration layer, not to cache identity.
//
// ---------------------------------------------------------------------------
// No raw provider response bodies, ever
// ---------------------------------------------------------------------------
// There is no `rawResponse` column and no credential column of any kind. Only
// the normalized, allow-listed P2-T2a result fields are persisted (see
// iocEnrichmentCacheRules.buildTerminalFields). `errorMessage` is re-derived
// from the closed PROVIDER_ERROR_MESSAGES map at write time — a caught
// Error's own `.message`, a response-body fragment, or a URL carrying an API
// key can never reach this table. This is BUILD_PLAN.md §2A's "or a safely
// stored normalized subset" branch, chosen deliberately over `rawResponse`.
// ===========================================================================

// Indicator types this cache can key on. IPV4 only for the MVP — matching
// iocEnrichmentTypes.INDICATOR_TYPES exactly. Adding a type later is additive.
enum IocIndicatorType {
  IPV4
}

// One-to-one with iocEnrichmentTypes.ENRICHMENT_STATUS. PENDING is the single
// non-terminal state (durable queued work); every other value is terminal and
// may carry an explicit `expiresAt`. A terminal row is never mutated again.
enum IocEnrichmentStatus {
  PENDING
  SUCCESS
  NOT_FOUND
  RATE_LIMITED
  INVALID_KEY
  TIMEOUT
  FAILED
  UNSUPPORTED_INDICATOR
  SKIPPED_DISABLED
  // Queue-lifecycle terminal state (P2-T2e-1), NOT a provider reputation
  // outcome. A job reaches DEAD_LETTER when a repeatable local failure
  // (a provider contract bug, an unregistered provider name, a rejected
  // completion payload) has exhausted `maxAttempts` — the provider never
  // produced this status and never can: createEnrichmentResult's taxonomy
  // (iocEnrichmentTypes.js ENRICHMENT_STATUS) deliberately does not contain
  // it, so `buildTerminalFields`/`findFreshCachedResult` can never treat a
  // dead-lettered row as reputation evidence. "We gave up processing this
  // job" is not "the address is clean".
  DEAD_LETTER
}

// One durable enrichment attempt: queued (PENDING), leased by a consumer, then
// completed once into exactly one terminal status. Terminal rows are retained
// as lookup history — a later attempt for the same cacheKey inserts a NEW row
// rather than overwriting the previous result.
model IocEnrichment {
  id Int @id @default(autoincrement())

  // --- Cache identity -----------------------------------------------------
  // Stable lowercase provider identifier ("mock", "abuseipdb") — a string,
  // not an enum, so adding a provider needs no migration (D-007).
  provider        String
  indicatorType   IocIndicatorType
  // Canonical indicator (strict dotted-quad IPv4 for IPV4).
  indicator       String
  // The allow-listed, normalized query parameters actually used — never a
  // passthrough of caller input (unknown keys, including an accidental
  // credential, are dropped before they get here).
  queryParams     Json
  queryParamsHash String
  // sha256 over the canonical (provider, indicatorType, indicator,
  // queryParams) serialization. THE cache identity; see enrichmentCacheKey.js.
  cacheKey        String

  // --- Queue ownership ----------------------------------------------------
  status      IocEnrichmentStatus @default(PENDING)
  requestedAt DateTime            @default(now())

  // Lease metadata. A live lease is (claimToken != null AND leaseExpiresAt >
  // now); an expired lease is reclaimable by another consumer. `claimToken`
  // is the ONLY completion credential — `updatedAt` is never used as a
  // concurrency version token (that mistake is already recorded and withdrawn
  // in STATUS.md for P1-T4).
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  claimToken     String?

  // "At most one active PENDING job per cacheKey", expressed as a plain
  // Prisma unique column — the same mechanism as FindingOwnership's
  // `currentForFindingId` (D-006). A PENDING row carries activeCacheKey ==
  // cacheKey; completion sets it back to null. PostgreSQL treats multiple
  // NULLs in a unique index as distinct, so any number of terminal history
  // rows may coexist for one cacheKey while at most one is active. No raw
  // SQL, no partial index.
  activeCacheKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Terminal result (all null while PENDING) ---------------------------
  // queriedAt/expiresAt are always supplied explicitly by the caller — no
  // wall-clock default. A null or already-past expiresAt means "not fresh",
  // for a success and a failure alike: a failed lookup is never readable as a
  // clean address.
  queriedAt DateTime?
  expiresAt DateTime?

  // Normalized SUCCESS payload only — populated for SUCCESS, null for every
  // other status (no partial/best-effort data on a failure).
  abuseConfidenceScore Int?
  totalReports         Int?
  countryCode          String?
  isp                  String?
  domain               String?
  usageType            String?
  isWhitelisted        Boolean?
  lastReportedAt       DateTime?

  // Transport/diagnostic context. errorCode is a closed PROVIDER_ERROR_CODES
  // value; errorMessage is re-derived from it, never caller-supplied text.
  // retryAfterSeconds is stored as whole seconds, rounded up (never shorter
  // than the provider asked for).
  httpStatus        Int?
  errorCode         String?
  errorMessage      String?
  retryAfterSeconds Int?

  // --- Retry / dead-letter bookkeeping (P2-T2e-1) -------------------------
  // Bounds how often a repeatably-failing job may be re-attempted, so a
  // "poison" job (e.g. persisted queryParams a provider's contract check
  // rejects on every call) cannot occupy a batch slot forever once scheduled
  // execution exists.
  //
  // attemptCount is incremented by the SAME guarded updateMany that
  // establishes a lease, so it counts genuine processing attempts only: a
  // consumer that loses the claim race never increments it.
  attemptCount  Int       @default(0)
  // Persisted per job (not read from config at claim time) so a job's budget
  // cannot silently change under it between attempts. Bounded on write by
  // iocEnrichmentCacheRules.assertValidMaxAttempts.
  maxAttempts   Int       @default(3)
  // Retry eligibility gate. null means "eligible now"; a future value hides
  // the row from listPendingCandidates until then. Always supplied
  // explicitly by the caller's policy — never a wall-clock default.
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?

  // Set only on the DEAD_LETTER transition. terminalReasonCode is a closed
  // ENRICHMENT_TERMINAL_REASON value — never a caught Error's message, a
  // provider payload, or any free-form text.
  deadLetteredAt     DateTime?
  terminalReasonCode String?

  // Fresh-cache lookup: newest unexpired terminal row for one cacheKey.
  @@index([cacheKey, status, expiresAt])
  // Pending-work lookup, in deterministic requestedAt order.
  @@index([status, requestedAt])
  // Retry-eligible pending-work lookup: status + nextAttemptAt gate, then the
  // deterministic requestedAt ordering the listing returns.
  @@index([status, nextAttemptAt, requestedAt])
  // Expired-lease recovery.
  @@index([status, leaseExpiresAt])
  // Provider/indicator lookup history.
  @@index([provider, indicatorType, indicator, queriedAt])
}

// ===========================================================================
// Phase 2 (P2-T3) — Deterministic, explainable, append-only risk scoring.
//
// Additive only. Introduces RiskScore + RiskFactorContribution and three
// enums. No column on any existing model is altered; the only edits elsewhere
// are two virtual back-relations (Finding.riskScores, User.riskCalculations).
//
// ---------------------------------------------------------------------------
// The locked v1 numeric contract lives in CODE, not in this database
// ---------------------------------------------------------------------------
// Weights, caps, bucket boundaries and band edges are an immutable frozen
// module (services/risk/riskConfiguration.js), NOT rows in a config table.
// This is the approved amendment to BUILD_PLAN.md section 2C's "versioned
// config row" wording — see STATUS.md D-T3-b. Historical truth is preserved
// not by keeping old config rows readable, but by persisting algorithmVersion,
// configurationVersion, configurationFingerprint AND every factor's own
// contribution on each snapshot: an old explanation renders entirely from its
// own stored rows and never consults today's configuration.
//
// ---------------------------------------------------------------------------
// Append-only, with exactly one current row per Finding
// ---------------------------------------------------------------------------
// currentForFindingId Int? @unique is the same mechanism as FindingOwnership
// (D-006) and IocEnrichment.activeCacheKey (D-007): PostgreSQL treats multiple
// NULLs in a unique index as distinct, so any number of superseded history
// rows may coexist while at most one row per Finding carries the pointer. No
// raw SQL, no partial index. Supersession sets supersededAt and nulls the
// pointer; it never edits the score, the band, or any contribution.
// ===========================================================================

// Final risk classification. Derived ONLY from the final integer score and
// the versioned band table — never assigned directly, never AI-decided.
enum RiskBand {
  INFORMATIONAL
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// What caused a calculation. MANUAL is the only trigger that carries an
// actorUserId; the rest are system-initiated at a state-change boundary.
enum RiskCalculationTrigger {
  INGESTION
  ENRICHMENT_COMPLETED
  OWNERSHIP_CHANGED
  MANUAL
  SYSTEM_RECALCULATION
}

// Why a factor contributed what it did. The distinction is load-bearing and
// is never collapsed: APPLIED means real evidence was scored (including a
// legitimate zero, e.g. AbuseIPDB SUCCESS with confidence 0); NOT_AVAILABLE
// means the evidence could not be obtained (failed/stale/absent enrichment,
// ownership too weak to attribute a sector) and must stay visibly distinct
// from clean evidence; NOT_APPLICABLE means the factor cannot apply to this
// kind of finding at all (CVE/KEV/EPSS on an exposure report with no CVE).
// All three store contributionBasisPoints, and only APPLIED may be non-zero.
enum RiskFactorApplicability {
  APPLIED
  NOT_AVAILABLE
  NOT_APPLICABLE
}

// One immutable scoring snapshot for one Finding. Never updated after
// insertion except for the intentional supersession transition
// (supersededAt + currentForFindingId -> null).
model RiskScore {
  id        Int     @id @default(autoincrement())
  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  // Versioning: which algorithm, which numeric contract, and the fingerprint
  // of that contract's canonical serialization. Stored per row so a score
  // calculated under v1.0.0 stays explicable after a later version ships.
  algorithmVersion         String
  configurationVersion     String
  configurationFingerprint String

  // Deterministic hash of the normalized factor inputs (plus algorithm and
  // configuration version). Equal fingerprint + equal configuration version
  // means "same approved input state", which is what makes a rescore return
  // UNCHANGED instead of flooding history with identical snapshots.
  inputFingerprint String

  // Integer basis points, 0-10000. No floating point anywhere in scoring;
  // displayScore is derived as floor(scoreBasisPoints / 100) at read time and
  // is deliberately NOT stored (it is a pure projection of this column).
  scoreBasisPoints Int
  riskBand         RiskBand

  // asOf is the explicit evaluation instant every input was read against and
  // every duration was measured from — never a wall-clock read inside the
  // engine. calculatedAt is when the row was actually written.
  asOf         DateTime
  calculatedAt DateTime @default(now())

  trigger RiskCalculationTrigger

  // Populated only for MANUAL. SetNull: deleting a user must never destroy
  // scoring history, only the actor attribution.
  actorUserId Int?
  actor       User? @relation("RiskScoreActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  // Bounded analyst justification for a MANUAL recalculation. Trimmed and
  // length-capped at the service boundary; never free-form provider or
  // exception text.
  justification String?

  currentForFindingId Int?      @unique
  supersededAt        DateTime?

  createdAt DateTime @default(now())

  contributions RiskFactorContribution[]

  // History reads for one Finding, newest first.
  @@index([findingId, calculatedAt])
  // Idempotency probe: does an existing snapshot already represent this exact
  // input state under this exact contract?
  @@index([findingId, inputFingerprint, configurationVersion])
  @@index([riskBand])
}

// One immutable row per approved factor per score. Every factor in the locked
// contract emits exactly one row on every snapshot, including NOT_AVAILABLE
// and NOT_APPLICABLE ones — that is what stops an explanation from silently
// omitting missing context. Never updated, never deleted outside test cleanup.
model RiskFactorContribution {
  id          Int       @id @default(autoincrement())
  riskScoreId Int
  riskScore   RiskScore @relation(fields: [riskScoreId], references: [id], onDelete: Restrict)

  // Closed vocabulary from the locked contract (RISK_FACTOR_KEYS). Stored as
  // a string rather than an enum so adding a factor in a future configuration
  // version needs no migration on this evidence table.
  factorKey     String
  applicability RiskFactorApplicability

  // Actual contribution and the cap it was drawn against. Storing the cap per
  // row is what lets an old explanation state "300 of a possible 1200"
  // truthfully after the cap changes in a later configuration version.
  contributionBasisPoints        Int
  maximumContributionBasisPoints Int

  // The bounded, normalized input the bucket was selected by (e.g. "6" for an
  // observation count, "88" for an abuse confidence score, "HEALTHCARE" for a
  // sector). Null when the factor was NOT_AVAILABLE/NOT_APPLICABLE. Never a
  // raw provider payload, never free text.
  normalizedInputValue String?

  // Closed RISK_EXPLANATION_CODES value. The rendered sentence is looked up
  // from this code, so no explanation is ever generated from a provider
  // response, an exception message, or a model.
  explanationCode String

  // Bounded allow-listed evidence for this factor only (small scalar keys,
  // e.g. {"observationCount":6}). Never a database row dump, never a raw
  // provider response, never headers or secrets.
  evidenceSnapshot Json?

  // Stable presentation order from the locked contract, so a rendered
  // explanation reads identically on every machine and every replay.
  displayOrder Int

  createdAt DateTime @default(now())

  // One contribution per factor per score.
  @@unique([riskScoreId, factorKey])
  // Deterministic ordered read of one score's contributions.
  @@index([riskScoreId, displayOrder])
}

// ===========================================================================
// Phase 2 (§2B) — Vulnerability intelligence: analyst-verified CVE
// associations plus durable NVD / CISA KEV / FIRST EPSS evidence.
//
// Additive only. Four new models and six new enums. No column on any existing
// model is altered; the only edits elsewhere are three virtual back-relations
// (Finding.vulnerabilityAssociations, User.vulnerabilityAssociations,
// User.vulnerabilityJobs).
//
// ---------------------------------------------------------------------------
// A CVE is NEVER inferred. It is asserted by a human.
// ---------------------------------------------------------------------------
// Nothing in this system derives a CVE from an exposed port, an RDP banner, a
// hostname, an operating-system guess, a CPE search, or an NVD keyword query.
// The ONLY way a Finding gains a CVE is an explicit ADMIN/ANALYST association
// carrying a justification (evidenceSource ANALYST_VERIFIED). NVD supplies
// metadata ABOUT a CVE an analyst already asserted; it never creates, confirms
// or revokes the assertion — an NVD NOT_FOUND leaves the association fully
// active and cvePresence still APPLIED.
//
// ---------------------------------------------------------------------------
// Why this is a job/result model, not another IocEnrichment-style cache row
// ---------------------------------------------------------------------------
// One CVE needs THREE independent provider answers (NVD metadata, KEV
// exploitation status, EPSS probability) that are fetched together and must
// commit together. A VulnerabilityEnrichmentJob is that unit of work; its
// VulnerabilityProviderResult rows are the evidence. This is the approved
// amendment to BUILD_PLAN §2B's three-table (enrichment_kev / enrichment_epss
// / enrichment_cve) wording — see STATUS.md D-2B-a. The KEV catalogue is NOT
// persisted: it is fetched at most once per executed batch and shared
// in-memory, because storing a full catalogue snapshot would be a raw provider
// payload, which this system does not keep.
// ===========================================================================

// Whether an analyst's CVE assertion currently stands. REMOVED is a
// retraction, never a delete: the history row survives so "who attached this,
// who took it off, and why" stays answerable.
enum VulnerabilityAssociationState {
  ACTIVE
  REMOVED
}

// How a Finding came to be associated with a CVE. Deliberately a single-value
// enum in this milestone: there is exactly one supported path, and making it
// an enum (rather than an implicit assumption) means a future automated path
// must declare itself explicitly rather than silently blending into
// analyst-verified evidence.
enum VulnerabilityEvidenceSource {
  ANALYST_VERIFIED
}

// Queue lifecycle for one CVE's enrichment work. DEAD_LETTER is a PROCESSING
// failure, never vulnerability evidence — a dead-lettered job can never be
// read as "this CVE is not exploited".
enum VulnerabilityJobStatus {
  PENDING
  COMPLETED
  DEAD_LETTER
}

// What caused a job to be scheduled.
enum VulnerabilityJobTrigger {
  ASSOCIATION_CREATED
  MANUAL
  FORCED_REFRESH
}

// The three vulnerability sources. An enum (unlike the IOC provider string)
// because each has bespoke normalized columns on VulnerabilityProviderResult,
// so adding a fourth genuinely requires a migration anyway.
enum VulnerabilityProvider {
  NVD
  CISA_KEV
  FIRST_EPSS
}

// Closed provider outcome taxonomy. Only SUCCESS may carry normalized data.
// NOT_FOUND means the provider answered "no record"; every other non-SUCCESS
// value means we could not obtain an answer at all, and none of them may ever
// be read as a negative finding.
enum VulnerabilityProviderStatus {
  SUCCESS
  NOT_FOUND
  RATE_LIMITED
  TIMEOUT
  INVALID_KEY
  FAILED
  SKIPPED_DISABLED
  UNSUPPORTED
}

// One canonical row per CVE ID. Created on demand when an analyst first
// references the CVE, and never deleted just because no association currently
// points at it — the provider evidence hanging off it stays valuable.
model Vulnerability {
  id    Int    @id @default(autoincrement())
  // Canonical uppercase CVE-YYYY-NNNN+ form, validated by cveIdentifier.js.
  cveId String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  findingAssociations FindingVulnerability[]
  enrichmentJobs      VulnerabilityEnrichmentJob[]
}

// Append-only association state between one Finding and one CVE.
//
// currentAssociationKey is the same distinct-NULLs mechanism as
// FindingOwnership.currentForFindingId (D-006) and IocEnrichment.activeCacheKey
// (D-007), but keyed on a PAIR, so it holds the string "<findingId>:<vulnId>"
// while current and null once superseded. PostgreSQL treats multiple NULLs in
// a unique index as distinct, so unlimited history rows coexist while at most
// one row per (Finding, CVE) pair is current. No raw SQL, no partial index.
model FindingVulnerability {
  id        Int     @id @default(autoincrement())
  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  vulnerabilityId Int
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Restrict)

  state          VulnerabilityAssociationState
  evidenceSource VulnerabilityEvidenceSource   @default(ANALYST_VERIFIED)

  // Bounded analyst-supplied text. sourceReference is a note ONLY: ThreatNeXus
  // never fetches, follows or dereferences it, so it can never become an SSRF
  // or automatic-evidence-discovery path.
  sourceReference String?
  justification   String

  // Always populated at write time (every transition is a human act); nullable
  // only so deleting a User nulls attribution instead of destroying history.
  actorUserId Int?
  actor       User? @relation("FindingVulnerabilityActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  effectiveAt  DateTime
  supersededAt DateTime?

  // "<findingId>:<vulnerabilityId>" while current, null once superseded.
  currentAssociationKey String? @unique

  createdAt DateTime @default(now())

  // Ordered history for one Finding, and the risk snapshot's ACTIVE lookup.
  @@index([findingId, effectiveAt])
  @@index([findingId, state])
  // Reverse lookup: which Findings does this CVE currently affect (used to
  // rescore after a job completes).
  @@index([vulnerabilityId, state])
}

// One bounded unit of enrichment work for one canonical CVE. All three
// providers are answered by a single job so their results commit together.
model VulnerabilityEnrichmentJob {
  id              Int           @id @default(autoincrement())
  vulnerabilityId Int
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Restrict)

  status      VulnerabilityJobStatus @default(PENDING)
  requestedAt DateTime               @default(now())
  completedAt DateTime?

  // Carries the vulnerabilityId as text while PENDING, null once terminal —
  // "at most one active job per CVE", same mechanism as activeCacheKey.
  activeJobKey String? @unique

  // Bounded attempt budget. attemptCount is incremented by the SAME guarded
  // update that establishes the lease, so a consumer that loses the claim race
  // never consumes budget.
  attemptCount  Int       @default(0)
  maxAttempts   Int       @default(3)
  nextAttemptAt DateTime?
  lastAttemptAt DateTime?

  // claimToken is the ONLY completion credential; updatedAt is never used as a
  // concurrency version token.
  claimedAt      DateTime?
  leaseExpiresAt DateTime?
  claimToken     String?

  // Set only on the DEAD_LETTER transition. terminalReasonCode is a closed
  // vocabulary value — never a caught Error's message or a provider payload.
  deadLetteredAt     DateTime?
  terminalReasonCode String?

  trigger     VulnerabilityJobTrigger
  actorUserId Int?
  actor       User?                   @relation("VulnerabilityJobActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerResults VulnerabilityProviderResult[]

  // Retry-eligible pending work, in deterministic requestedAt order.
  @@index([status, nextAttemptAt, requestedAt])
  // Expired-lease recovery.
  @@index([status, leaseExpiresAt])
  // Job history for one CVE.
  @@index([vulnerabilityId, requestedAt])
}

// One immutable normalized outcome per provider per job. Never updated after
// the job completes.
//
// There is deliberately NO rawResponse column, no headers column and no
// credential column: only allow-listed, individually validated, bounded fields
// survive normalization. Free-text fields (englishDescription, requiredAction)
// are length-capped at the service boundary.
model VulnerabilityProviderResult {
  id    Int                        @id @default(autoincrement())
  jobId Int
  job   VulnerabilityEnrichmentJob @relation(fields: [jobId], references: [id], onDelete: Restrict)

  provider VulnerabilityProvider
  status   VulnerabilityProviderStatus

  // Always explicit, never a wall-clock default. Freshness is the half-open
  // window [queriedAt, expiresAt) evaluated at the risk snapshot's asOf —
  // identical to the IOC enrichment rule.
  queriedAt DateTime
  expiresAt DateTime

  // Transport/diagnostic context. errorCode is a closed vocabulary value;
  // there is no errorMessage column at all, so provider or exception text has
  // nowhere to land.
  httpStatus        Int?
  errorCode         String?
  retryAfterSeconds Int?

  // --- NVD normalized metadata (SUCCESS only) -----------------------------
  // CVSS is stored as integer TENTHS (9.8 -> 98) so no floating-point value
  // is ever persisted or compared. It is displayed as context and is
  // deliberately NOT a Risk v1 factor.
  nvdCveStatus        String?
  publishedAt         DateTime?
  lastModifiedAt      DateTime?
  englishDescription  String?
  cvssVersion         String?
  cvssBaseScoreTenths Int?
  cvssSeverity        String?
  // Bounded, validated array of CWE identifiers (e.g. ["CWE-416"]).
  primaryCweIds       Json?
  sourceIdentifier    String?

  // --- CISA KEV normalized fields (SUCCESS only) --------------------------
  // isKnownExploited false is USABLE NEGATIVE EVIDENCE, but only because the
  // catalogue was successfully fetched and this CVE was absent from it. A
  // catalogue that could not be fetched produces a non-SUCCESS status and
  // leaves isKnownExploited null — never false.
  isKnownExploited           Boolean?
  dateAdded                  DateTime?
  dueDate                    DateTime?
  knownRansomwareCampaignUse String?
  requiredAction             String?
  catalogVersion             String?
  catalogReleasedAt          DateTime?

  // --- FIRST EPSS normalized fields (SUCCESS only) ------------------------
  // Probability and percentile are integer basis points (0-10000), converted
  // from the provider's decimal STRING by a strict parser — never parseFloat,
  // never Number(x) * 10000.
  epssProbabilityBasisPoints Int?
  epssPercentileBasisPoints  Int?
  modelDate                  DateTime?

  createdAt DateTime @default(now())

  // Exactly one result per provider per job.
  @@unique([jobId, provider])
  // Freshness lookup for the risk snapshot.
  @@index([provider, status, expiresAt])
}

// ===========================================================================
// Phase 3 — Defensible analyst workflow.
//
// Additive only. Six new models and ten new enums. The existing Case model
// is EXTENDED (nullable/defaulted columns only), never duplicated; Notification
// is untouched entirely. No column on any Phase 0/1/2 model is altered or
// removed — the only edits elsewhere are the additive Case columns above and
// virtual back-relations on User / Organization / Finding / FindingOccurrence.
//
// ---------------------------------------------------------------------------
// The whole phase is append-only evidence with one-current-row projections
// ---------------------------------------------------------------------------
// FindingTriage.currentForFindingId, CaseFinding.currentLinkKey and
// CaseClosureRequest.activeCaseId are all the SAME distinct-NULLs mechanism
// already used by FindingOwnership.currentForFindingId (D-006),
// IocEnrichment.activeCacheKey (D-007), RiskScore.currentForFindingId and
// FindingVulnerability.currentAssociationKey: PostgreSQL treats multiple NULLs
// in a unique index as distinct, so unlimited history rows coexist while at
// most one row is "current". No raw SQL, no partial index.
//
// CaseLifecycleEvent, CaseOrganizationResponse and CaseRecurrenceReopen have no
// current-row pointer at all because nothing about them is ever superseded —
// they are pure immutable timelines.
//
// ---------------------------------------------------------------------------
// Nothing here closes a case on its own
// ---------------------------------------------------------------------------
// A REMEDIATED organization response is a CLAIM by the affected party, not
// proof. It can never close a case by itself: closure always requires an
// explicit CaseClosureRequest by an ADMIN/ANALYST and an explicit approval by a
// REVIEWER/ADMIN, and a REMEDIATED closure additionally requires that such a
// response actually exists (recorded as supportingResponseId). This is the
// separation of duties BUILD_PLAN.md requires, expressed in the schema.
//
// ---------------------------------------------------------------------------
// There is no hard-delete path
// ---------------------------------------------------------------------------
// Every FK from this section onto Case / Finding / FindingOccurrence /
// Organization is Restrict; every actor FK is SetNull. Deleting a user nulls
// attribution but never destroys the record that justified a decision, and a
// case carrying any workflow history simply cannot be removed.
// ===========================================================================

// Analyst triage decision on a Finding. Deliberately SEPARATE from
// FindingStatus (OPEN/CLOSED): FindingStatus is the exposure state driven by
// observation evidence, triage is the analyst judgement about what to do with
// it. A Finding can be OPEN and DISMISSED, or CLOSED and ESCALATED —
// collapsing the two would make "we decided to ignore this" indistinguishable
// from "it stopped being observed".
//
// The absence of any FindingTriage row means UNTRIAGED. That is deliberately
// NOT an enum value: an enum member would need a row to express it, and
// writing a row would mean every Finding ever ingested acquires triage history
// it never actually received.
enum FindingTriageDecision {
  IN_REVIEW
  ESCALATED
  DISMISSED
}

// What caused a triage row. ANALYST_DECISION is an explicit human act through
// the triage endpoint; the other two are system consequences of a human act
// elsewhere (linking evidence into a case, a recurrence reopening one) and are
// kept distinguishable so an audit can tell an analyst own judgement from a
// workflow side effect.
enum FindingTriageSource {
  ANALYST_DECISION
  CASE_LINK
  RECURRENCE_REOPEN
}

// The authoritative case lifecycle. CLOSURE_PENDING is a real state, not a
// flag: while a case sits in it the closure is neither in force nor discarded,
// and only a reviewer decision moves it out.
enum CaseLifecycleState {
  OPEN
  WAITING_FOR_ORG
  CLOSURE_PENDING
  CLOSED
}

// Immutable lifecycle event kinds. CREATED is emitted once per case so the
// timeline is complete from the first instant and never starts mid-story.
enum CaseLifecycleEventType {
  CREATED
  STATE_CHANGED
  CLOSURE_REQUESTED
  CLOSURE_APPROVED
  CLOSURE_REJECTED
  REOPENED
}

// Whether a Finding is currently evidence in a case. UNLINKED is a retraction,
// never a delete: the history row survives so "this Finding was evidence in
// that case between these two instants" stays answerable after the fact.
enum CaseFindingLinkState {
  LINKED
  UNLINKED
}

// What the affected organization told us. NO_RESPONSE is an explicit recorded
// observation ("we chased, nothing came back"), which is different from — and
// must never be confused with — the absence of any response row at all.
enum OrganizationResponseType {
  ACKNOWLEDGED
  INVESTIGATING
  REMEDIATED
  DISPUTED
  NO_RESPONSE
  OTHER
}

// Why a case was closed. Only REMEDIATED is treated as "the exposure was
// actually fixed", which is why it is the ONLY reason a later recurrence may
// automatically reopen: reopening a FALSE_POSITIVE or ACCEPTED_RISK closure on
// the next observation would re-litigate a decision that was already made
// knowing the finding would keep being observed.
enum CaseClosureReason {
  REMEDIATED
  FALSE_POSITIVE
  ACCEPTED_RISK
  DUPLICATE
  OTHER
}

// Closure-request review state. Terminal states are never rewritten — a case
// that is reopened later gets a NEW request if it is to be closed again.
enum CaseClosureRequestState {
  PENDING
  APPROVED
  REJECTED
}

// How a case came to be reopened. RECURRENCE is the automatic path (a newer
// RECURRED FindingOccurrence on linked evidence); MANUAL is an explicit
// analyst act with its own recorded reason.
enum CaseReopenTrigger {
  MANUAL
  RECURRENCE
}

// Outcome of evaluating ONE (recurrence occurrence, case) pair. Every
// evaluation is recorded, including the ones that decided NOT to reopen —
// that is what makes repeated processing idempotent AND leaves evidence that
// the rule was actually applied rather than silently skipped.
enum CaseRecurrenceReopenOutcome {
  REOPENED
  SKIPPED_NOT_CLOSED
  SKIPPED_CLOSURE_REASON_NOT_REMEDIATED
}

// Append-only triage history for a Finding. Every decision inserts a new row;
// existing rows are NEVER updated or deleted (only supersededAt /
// currentForFindingId change on the row being superseded, in the same
// transaction that inserts its replacement).
model FindingTriage {
  id        Int     @id @default(autoincrement())
  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  decision FindingTriageDecision
  source   FindingTriageSource   @default(ANALYST_DECISION)

  // Required by the service layer for DISMISSED (a dismissal with no stated
  // reason is not defensible) and bounded for every decision. Analyst free
  // text — never provider output, never an exception message.
  reason String?

  // The case whose link or recurrence produced a CASE_LINK /
  // RECURRENCE_REOPEN row. Null for an ordinary ANALYST_DECISION. Restrict
  // rather than SetNull, matching every other Phase 3 FK: a case is never
  // hard-deleted once it has history, so nulling attribution is unnecessary
  // and would quietly erase which case escalated this Finding.
  caseId Int?
  case   Case? @relation("FindingTriageCase", fields: [caseId], references: [id], onDelete: Restrict)

  actorUserId Int?
  actor       User? @relation("FindingTriageActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  decidedAt    DateTime
  supersededAt DateTime?

  // findingId while current, null once superseded — "at most one current
  // triage decision per Finding" with no raw SQL and no partial index.
  currentForFindingId Int? @unique

  createdAt DateTime @default(now())

  @@index([findingId, decidedAt])
  @@index([decision])
  @@index([caseId])
}

// Append-only evidence-link history between one Case and one Finding.
//
// Linking copies NOTHING from the Finding. The Finding indicator, ports,
// occurrences, ownership, enrichment and risk stay exactly where they are and
// are read through their own services; this table records only that a link
// exists (or existed) and the ownership basis on which it was accepted.
model CaseFinding {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  state CaseFindingLinkState

  // The organization the link was accepted against — always equal to the
  // case organizationId at link time. Stored explicitly (rather than joined
  // through the case) so a historical link stays explicable on its own, and
  // so a mismatch introduced by any future change is detectable rather than
  // invisible.
  organizationId Int
  organization   Organization @relation("CaseFindingOrganization", fields: [organizationId], references: [id], onDelete: Restrict)

  // Snapshot of WHY the ownership check passed at link time. Deliberately
  // scalar enum values, not a FindingOwnership foreign key: a Restrict FK onto
  // the append-only ownership history would make that history undeletable by
  // every existing real-database cleanup path, and the link justification
  // only needs the decision, not the row.
  ownershipStatusAtLink     OwnershipResolutionStatus
  ownershipConfidenceAtLink OwnershipConfidence?

  // Bounded analyst note, required by the service layer on UNLINK (removing
  // evidence from a case must state why).
  reason String?

  actorUserId Int?
  actor       User? @relation("CaseFindingActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  effectiveAt  DateTime
  supersededAt DateTime?

  // "<caseId>:<findingId>" while current, null once superseded — at most one
  // current link row per (Case, Finding) pair, same distinct-NULLs mechanism.
  currentLinkKey String? @unique

  createdAt DateTime @default(now())

  @@index([caseId, state])
  @@index([findingId, effectiveAt])
  @@index([organizationId])
}

// Immutable case lifecycle timeline. One row per accepted transition, written
// in the SAME transaction as the guarded state change it describes, so a case
// can never reach a state with no event explaining how it got there.
model CaseLifecycleEvent {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  eventType CaseLifecycleEventType
  // Null only for CREATED (there is no prior state).
  fromState CaseLifecycleState?
  toState   CaseLifecycleState

  // Closed machine-readable vocabulary (see caseLifecycleRules.js
  // LIFECYCLE_REASON_CODES) — never free text, never an exception message.
  reasonCode String

  // Bounded analyst-supplied note. Optional, trimmed and length-capped at the
  // service boundary.
  note String?

  actorUserId Int?
  actor       User? @relation("CaseLifecycleActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([caseId, occurredAt])
  @@index([eventType])
}

// Immutable append-only timeline of what the affected organization said.
// Never treated as proof of anything on its own — see the section header.
model CaseOrganizationResponse {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  responseType OrganizationResponseType

  // Bounded analyst-authored summary of what was communicated. Deliberately a
  // SUMMARY column and not a verbatim-message column: storing complete
  // correspondence would put third-party contact detail and potentially
  // victim data into a table the whole workflow reads.
  summary String

  // Optional safe reference — a ticket id, an internal case number. Stored and
  // displayed as an opaque string and NEVER dereferenced, fetched or followed
  // by anything in this system, exactly like FindingVulnerability
  // .sourceReference, so it cannot become an SSRF or auto-discovery path.
  reference String?

  // When the organization actually responded, which is not when we recorded
  // it. Both are kept.
  occurredAt DateTime
  recordedAt DateTime @default(now())

  recordedByUserId Int?
  recordedBy       User? @relation("CaseResponseRecordedBy", fields: [recordedByUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  supportedClosureRequests CaseClosureRequest[] @relation("ClosureSupportingResponse")

  @@index([caseId, occurredAt])
  @@index([caseId, responseType])
}

// One closure request and its review. Append-only: an APPROVED or REJECTED
// row is never rewritten, and a case that is reopened and re-closed later
// accumulates a second request rather than mutating the first.
model CaseClosureRequest {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  state         CaseClosureRequestState @default(PENDING)
  closureReason CaseClosureReason

  // Bounded, required. The analyst stated case for closing.
  justification String

  requestedByUserId Int?
  requestedBy       User?    @relation("CaseClosureRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  requestedAt       DateTime

  reviewedByUserId Int?
  reviewedBy       User?     @relation("CaseClosureReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?
  // Bounded reviewer note. Required by the service layer on rejection.
  reviewNote       String?

  // The specific REMEDIATED organization response this closure rests on.
  // Populated only for closureReason REMEDIATED, and required there — that is
  // how "REMEDIATED closure requires a recorded REMEDIATED response" becomes a
  // durable fact rather than a check that happened once. Restrict: the
  // evidence a closure was approved on must not vanish.
  supportingResponseId Int?
  supportingResponse   CaseOrganizationResponse? @relation("ClosureSupportingResponse", fields: [supportingResponseId], references: [id], onDelete: Restrict)

  // caseId while PENDING, null once APPROVED/REJECTED — "at most one open
  // closure request per case", same distinct-NULLs mechanism as everywhere
  // else in this repository. No raw SQL, no partial index.
  activeCaseId Int? @unique

  createdAt DateTime @default(now())

  @@index([caseId, requestedAt])
  @@index([state])
}

// The recurrence-reopen ledger. Exactly one row per (recurrence occurrence,
// case) pair, which is what makes repeated processing of the same occurrence
// idempotent.
//
// FindingOccurrence own (findingId, rawReportId) identity is NOT sufficient on
// its own: one recurrence can fan out to several linked cases, each of which
// needs its own decision recorded, and each of which must be re-runnable
// exactly once. The composite unique below is that missing identity.
model CaseRecurrenceReopen {
  id     Int  @id @default(autoincrement())
  caseId Int
  case   Case @relation(fields: [caseId], references: [id], onDelete: Restrict)

  findingId Int
  finding   Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)

  findingOccurrenceId Int
  findingOccurrence   FindingOccurrence @relation(fields: [findingOccurrenceId], references: [id], onDelete: Restrict)

  outcome CaseRecurrenceReopenOutcome

  // The recurrence observation time, and when this evaluation ran. Both
  // explicit, never a wall-clock read inside the service.
  observedAt  DateTime
  processedAt DateTime

  createdAt DateTime @default(now())

  // THE idempotency key.
  @@unique([findingOccurrenceId, caseId])
  @@index([caseId, processedAt])
  @@index([findingId])
}
