generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("analyst")
  createdAt DateTime @default(now())
}
model Threat {
  id         Int      @id @default(autoincrement())
  ip         String?
  domain     String?
  hash       String?
  severity   String
  source     String
  riskScore  Int
  status     String
  iocType    String?
  createdAt  DateTime @default(now())
}
model Case {
  id          Int      @id @default(autoincrement())
  title       String
  threatType  String
  organization String
  priority    String   @default("Medium")
  status      String   @default("Open")
  analyst     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
model Notification {
  id        Int      @id @default(autoincrement())
  title     String
  message   String
  severity  String   @default("Low")
  status    String   @default("Unread")
  type      String   @default("System")
  createdAt DateTime @default(now())
}
model Organization {
  id            Int      @id @default(autoincrement())
  name          String
  industry      String
  location      String
  contactPerson String
  email         String   @unique
  phone         String?
  securityScore Int      @default(100)
  activeThreats Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}