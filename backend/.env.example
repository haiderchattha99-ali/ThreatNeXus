# ThreatNeXus backend — environment variables.
# Copy this file to .env and fill in real values for your machine.
# Never commit .env. No real secrets belong in this file.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Matches docker-compose.yml defaults if used.
DATABASE_URL=postgresql://threatnexus:CHANGE_ME@localhost:5432/threatnexus?schema=public

# REQUIRED. Minimum 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Comma-separated list of allowed browser origins. Never "*" in production.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
UPLOAD_MAX_BYTES=5242880

# Seed script only (backend/prisma/seed.js). Never read by the running application.
SEED_ADMIN_EMAIL=
SEED_DEFAULT_PASSWORD=

# ---------------------------------------------------------------------------
# Phase 2 (IOC reputation enrichment) — declared now, not read by anything yet.
# ---------------------------------------------------------------------------
IOC_ENRICHMENT_PROVIDER=mock
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_TIMEOUT_MS=5000
ABUSEIPDB_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Phase 5 (AI assistance) — declared now, not read by anything yet.
# AI is optional and disabled by default.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=null
