# ThreatNeXus backend — environment variables.
# Copy this file to .env and fill in real values for your machine.
# Never commit .env. No real secrets belong in this file.

NODE_ENV=development
PORT=5000

# PostgreSQL connection string. Matches the root docker-compose.yml defaults
# (service "postgres", db/user "threatnexus"). Change the password if you
# started that compose file with a different POSTGRES_PASSWORD.
DATABASE_URL=postgresql://threatnexus:threatnexus_local_dev_only@localhost:5432/threatnexus?schema=public

# REQUIRED. Minimum 32 characters. The value below is a local-dev-only
# placeholder — generate your own with: openssl rand -base64 48
JWT_SECRET=local-dev-only-example-value-replace-before-use
JWT_EXPIRES_IN=24h

# Public self-service registration. CLOSED unless this is exactly "true".
#
# VIEWER — the role a self-service account receives — legitimately holds
# read:dashboard, read:findings and read:cases. That is correct for an account
# the organization issued and wrong for one anybody can mint: with this open,
# an anonymous caller can create an account and then read every finding
# (victim address, port, owning organization), every case and the dashboard.
#
# Leave it closed. Accounts are provisioned with `npm run seed:users`. Set it
# true only for a throwaway local bootstrap, and set it back afterwards.
ALLOW_PUBLIC_REGISTRATION=false

# Comma-separated list of allowed browser origins. Never "*" in production.
CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=info
UPLOAD_MAX_BYTES=5242880

# Maximum data rows (excluding the header) accepted in one
# accessible-rdp.synthetic.v1 CSV upload. An oversized report is rejected
# rather than truncated.
REPORT_MAX_ROWS=5000

# Read only by backend/src/scripts/seedUsers.js (npm run seed:users), never by
# the running application. Required to create the four Phase 0 local demo
# users (ADMIN/ANALYST/REVIEWER/VIEWER at *@threatnexus.local). Leave this
# blank here — set it as a temporary shell variable when you run the script,
# never commit a real value:
#   SEED_USER_PASSWORD=<a-strong-local-only-password> npm run seed:users
SEED_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Phase 2 (IOC reputation enrichment). IOC_ENRICHMENT_PROVIDER selects which
# registered provider ("mock" or "abuseipdb") a future caller resolves — no
# ingestion/route code reads it yet (P2-T2d). ABUSEIPDB_API_KEY is optional:
# leaving it blank does not block startup, it only leaves the real provider
# disabled (every lookup returns SKIPPED_DISABLED). BASE_URL/TIMEOUT_MS/
# MAX_AGE_DAYS are validated at startup — an out-of-range or non-numeric
# value fails configuration validation. Get a free key at
# https://www.abuseipdb.com/account/api if you want to exercise the real
# provider manually; automated tests always use MockProvider.
# ---------------------------------------------------------------------------
IOC_ENRICHMENT_PROVIDER=mock
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_TIMEOUT_MS=8000
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Phase 8B (Censys internet-exposure/attack-surface enrichment), against
# Censys's Platform API. CENSYS_PAT is a Personal Access Token (Bearer auth) —
# leaving it blank does not block startup, it only leaves the provider
# disabled (every lookup returns SKIPPED_DISABLED). CENSYS_ORG_ID is optional
# even when CENSYS_PAT is set; only needed if your account belongs to more
# than one Censys organization. BASE_URL/TIMEOUT_MS are validated at startup —
# an out-of-range or non-numeric value fails configuration validation. Get a
# token at https://platform.censys.io (account -> Personal Access Tokens) if
# you want to exercise the real provider manually (npm run smoke:censys, with
# LIVE_CENSYS_SMOKE=1 set); automated tests always inject their own fetch.
# ---------------------------------------------------------------------------
CENSYS_PAT=
CENSYS_ORG_ID=
CENSYS_BASE_URL=https://api.platform.censys.io/v3
CENSYS_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Phase 8D (GreyNoise internet-noise/reputation enrichment), against
# GreyNoise's Community API. GREYNOISE_API_KEY is optional — leaving it blank
# does not block startup, it only leaves the provider disabled (every lookup
# returns SKIPPED_DISABLED). BASE_URL/TIMEOUT_MS are validated at startup —
# an out-of-range or non-numeric value fails configuration validation. Get a
# free Community API key at https://viz.greynoise.io/account/ if you want to
# exercise the real provider manually (npm run smoke:greynoise, with
# LIVE_GREYNOISE_SMOKE=1 set); automated tests always inject their own fetch.
# ---------------------------------------------------------------------------
GREYNOISE_API_KEY=
GREYNOISE_BASE_URL=https://api.greynoise.io/v3/community
GREYNOISE_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Phase 8E (Shodan exposed-service/banner/port intelligence), against
# Shodan's REST API. SHODAN_API_KEY is optional — leaving it blank does not
# block startup, it only leaves the provider disabled (every lookup returns
# SKIPPED_DISABLED). Shodan authenticates via a `key` query parameter (its
# own documented scheme, not a header) — the key is never logged, printed,
# or included in any error/audit output. BASE_URL/TIMEOUT_MS are validated
# at startup — an out-of-range or non-numeric value fails configuration
# validation. Get a key at https://account.shodan.io if you want to
# exercise the real provider manually (npm run smoke:shodan, with
# LIVE_SHODAN_SMOKE=1 set); automated tests always inject their own fetch.
# ---------------------------------------------------------------------------
SHODAN_API_KEY=
SHODAN_BASE_URL=https://api.shodan.io
SHODAN_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Phase 8F (Netlas cross-source attack-surface/DNS/certificate/service
# intelligence), against Netlas's REST API. NETLAS_API_KEY is optional —
# leaving it blank does not block startup, it only leaves the provider
# disabled (every lookup returns SKIPPED_DISABLED). Netlas authenticates via
# an `Authorization: Bearer <key>` header (RFC 6750, its current documented
# scheme — the older `X-Api-Key` header is deprecated) — the key is never
# logged, printed, or included in any error/audit output. BASE_URL/
# TIMEOUT_MS are validated at startup — an out-of-range or non-numeric value
# fails configuration validation. Get a key at https://app.netlas.io if you
# want to exercise the real provider manually (npm run smoke:netlas, with
# LIVE_NETLAS_SMOKE=1 set); automated tests always inject their own fetch.
# ---------------------------------------------------------------------------
NETLAS_API_KEY=
NETLAS_BASE_URL=https://app.netlas.io
NETLAS_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Phase 5 (AI assistance) — declared now, not read by anything yet.
# AI is optional and disabled by default.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=null

# ---------------------------------------------------------------------------
# Phase 2 (§2B) — vulnerability context providers.
#
# All three are OPTIONAL and none is required to start the application.
# NVD works without a key at a lower public rate limit, so an absent
# NVD_API_KEY is a different mode rather than a broken one. CISA KEV and
# FIRST EPSS take no key at all.
#
# NVD attribution, required wherever NVD data is shown or described:
#   "This product uses the NVD API but is not endorsed or certified by the NVD."
# ---------------------------------------------------------------------------
NVD_API_KEY=
NVD_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_TIMEOUT_MS=10000
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json
CISA_KEV_TIMEOUT_MS=15000
FIRST_EPSS_BASE_URL=https://api.first.org/data/v1/epss
FIRST_EPSS_TIMEOUT_MS=10000
VULNERABILITY_BATCH_SIZE=10
VULNERABILITY_LEASE_SECONDS=120
VULNERABILITY_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Phase 6 — the demonstration dataset (backend/src/scripts/seedDemo.js).
#
# Both are read ONLY by `npm run seed:demo`, never by the running application.
# The script refuses to run unless DEMO_MODE is exactly "true", refuses to run
# with NODE_ENV=production, and refuses to run without a DEMO_USER_PASSWORD of
# at least 12 characters. Supply them as one-off shell variables — never commit
# a real value:
#   DEMO_MODE=true DEMO_USER_PASSWORD='<local-only>' npm run seed:demo
# ---------------------------------------------------------------------------
DEMO_MODE=false
DEMO_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Phase 6 — test hermeticity. Set ONLY by backend/tests/setup.js, never by you.
# When "true", src/config/env.js skips its dotenv load so the automated suite
# constructs its own environment instead of inheriting this file's values
# (including any real provider key).
# ---------------------------------------------------------------------------
# TNX_SKIP_DOTENV=

# ---------------------------------------------------------------------------
# Phase 7 — request rate limiting.
#
# Three independent buckets, so one surface cannot exhaust another's budget:
#
#   auth     login + register, counted together. The tightest bucket, because
#            it is the only one an attacker can drive with no account at all.
#   upload   report ingestion. Each accepted upload costs a multipart disk
#            write plus a bounded parse of up to REPORT_MAX_ROWS rows.
#   provider explicit provider execution — IOC enrichment, CVE enrichment,
#            both batch workers, and an AI suggestion generation run. This
#            bounds how often a caller may ASK for third-party spend; it is a
#            different control from the provider queue/cache/TTL policy, which
#            bounds how much work actually reaches the third party.
#
# Authenticated callers are counted per user id, unauthenticated ones per
# client address. The application does not set Express `trust proxy`, so
# X-Forwarded-For cannot be used to rotate a limiter key. If you put a reverse
# proxy in front of the backend, configure `trust proxy` deliberately and only
# for that proxy — enabling it blindly makes the limiter bypassable by anyone
# able to set a header.
#
# RATE_LIMIT_ENABLED defaults to true everywhere except NODE_ENV=test, where
# ~3,000 tests share one process and one loopback address. The control is
# still proven: tests/integration/phase7RateLimiting.test.js turns each bucket
# on explicitly and drives it past its limit.
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_UPLOAD_WINDOW_MS=900000
RATE_LIMIT_UPLOAD_MAX=20
RATE_LIMIT_PROVIDER_WINDOW_MS=900000
RATE_LIMIT_PROVIDER_MAX=60

# ---------------------------------------------------------------------------
# Phase 10A-1 — enrichment orchestration (INERT: records intent, executes
# nothing)
# ---------------------------------------------------------------------------
# This milestone adds durable orchestration records — which providers SHOULD be
# asked about which subjects for a Finding — and stops there. It performs zero
# provider calls, creates zero quota reservations and zero attempt rows, and
# starts no worker. Execution arrives in Phase 10A-2.
#
# TWO INDEPENDENT DEFAULT-OFF CONTROLS, on purpose:
#
#   AUTO_ENRICHMENT_ENABLED    whether report ingestion records orchestration
#                              runs at all. false = ingestion behaves exactly
#                              as it did before this milestone: the existing
#                              IocEnrichment row is still created and NO
#                              Phase-10 run/item/job/attempt/usage row exists.
#
#   ENRICHMENT_WORKER_ENABLED  declared and validated, consumed by nothing in
#                              10A-1 — there is no worker to enable yet. It is
#                              here so a deployment cannot be "upgraded into"
#                              an active worker by a later release without an
#                              explicit configuration change.
#
# Both accept exactly the string "true" to turn on. There is deliberately no
# 1/yes/on synonym: a switch that spends third-party quota should have one
# unambiguous spelling.
AUTO_ENRICHMENT_ENABLED=false
ENRICHMENT_WORKER_ENABLED=false

# ---------------------------------------------------------------------------
# Phase 10A-2 — the worker runtime
# ---------------------------------------------------------------------------
# ENRICHMENT_WORKER_ENABLED now genuinely starts a worker that CALLS PROVIDERS
# and SPENDS REAL QUOTA. It stays false by default, and turning it on is still
# not sufficient on its own: a provider also needs its credential AND a
# positive budget for the lane in question.
#
# THESE FOUR ARE NOT INDEPENDENT. They are cross-validated at startup, and a
# combination that would let recovery act on work that is still running fails
# configuration validation loudly rather than silently corrupting accounting:
#
#   ENRICHMENT_WORKER_LEASE_SECONDS   >= ENRICHMENT_LOOKUP_MAX_MS + 30s
#   ENRICHMENT_ATTEMPT_STALE_SECONDS  >= ENRICHMENT_LOOKUP_MAX_MS + 60s
#
# Both rules are stated against ENRICHMENT_LOOKUP_MAX_MS — the worker's OWN
# end-to-end bound — and NOT against any provider's configured timeout. No
# provider timeout actually bounds a lookup: every provider clears its timeout
# as soon as the response HEADERS arrive and reads the body afterwards, so a
# stalled body read runs unbounded. The worker imposes its own bound at its own
# call site instead.
ENRICHMENT_WORKER_POLL_INTERVAL_MS=15000
ENRICHMENT_WORKER_BATCH_SIZE=5
ENRICHMENT_WORKER_LEASE_SECONDS=120
ENRICHMENT_LOOKUP_MAX_MS=60000
ENRICHMENT_ATTEMPT_STALE_SECONDS=600

# Per-provider daily budgets, per lane. AUTOMATIC is ingestion-triggered work;
# MANUAL is an analyst explicitly asking.
#
# EVERY AUTOMATIC BUDGET DEFAULTS TO 0. That is belt-and-braces on top of the
# switches above: even an operator who turns AUTO_ENRICHMENT_ENABLED on cannot
# spend a single unit of automatic third-party quota without also raising a
# budget here on purpose. A routed target whose automatic budget is 0 is
# recorded as SKIPPED_BUDGET and creates NO lookup job at all.
#
# MANUAL budgets default to unlimited (blank, or the literal "unlimited"), on
# the reasoning that an analyst pressing a button is an explicit human
# decision already bounded by RATE_LIMIT_PROVIDER_*. A blank value is still
# parsed and validated — a malformed value fails startup loudly rather than
# silently resolving to "unlimited".
#
# Accepted: an integer 0..1000000, or (MANUAL only) the literal "unlimited".
ABUSEIPDB_AUTOMATIC_DAILY_BUDGET=0
ABUSEIPDB_MANUAL_DAILY_BUDGET=
CENSYS_AUTOMATIC_DAILY_BUDGET=0
CENSYS_MANUAL_DAILY_BUDGET=
GREYNOISE_AUTOMATIC_DAILY_BUDGET=0
GREYNOISE_MANUAL_DAILY_BUDGET=
SHODAN_AUTOMATIC_DAILY_BUDGET=0
SHODAN_MANUAL_DAILY_BUDGET=
NETLAS_AUTOMATIC_DAILY_BUDGET=0
NETLAS_MANUAL_DAILY_BUDGET=
NVD_AUTOMATIC_DAILY_BUDGET=0
NVD_MANUAL_DAILY_BUDGET=

# ---------------------------------------------------------------------------
# Phase 10C-3 — provider operability (READ-ONLY: reports the above, changes
# nothing)
# ---------------------------------------------------------------------------
# Every credential, budget and switch above is READ, never written, by
# ThreatNeXus itself. An ADMIN-only screen (Settings -> "Enrichment budgets
# and readiness") and GET /api/enrichment/usage report, per provider, whether
# it is READY, and if not, exactly which variable above is missing or which
# switch/budget is blocking it. Nothing in the application can set a
# credential, change a budget, or flip AUTO_ENRICHMENT_ENABLED /
# ENRICHMENT_WORKER_ENABLED.
#
# Every variable in this file is read ONCE, at process start, and frozen —
# see backend/src/config/env.js. Editing any value above and expecting it to
# take effect requires a RESTART of the backend process; there is no live
# reload.
