# ThreatNeXus backend — test environment variables.
# Copy this file to .env.test for local test runs. Never commit .env.test.
# These are deterministic, non-production placeholders only — not real credentials.

NODE_ENV=test
PORT=5001

# Local/ephemeral test database only. Never point this at a real environment.
DATABASE_URL=postgresql://threatnexus_test:test_only@localhost:5432/threatnexus_test?schema=public

# TEST-ONLY placeholder secret. 49 characters. Not suitable for production use.
JWT_SECRET=test-only-jwt-secret-do-not-use-in-production-env
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:5173

LOG_LEVEL=silent
UPLOAD_MAX_BYTES=5242880

# backend/src/scripts/seedUsers.js is not invoked by the automated test suite
# (unit tests mock Prisma; see backend/tests/unit/seedUsers.test.js), so no
# SEED_USER_PASSWORD is needed here.

# ---------------------------------------------------------------------------
# Phase 2 (IOC reputation enrichment) — tests use MockProvider only; nothing
# in the automated suite calls the real AbuseIPDBProvider against the network.
# ---------------------------------------------------------------------------
IOC_ENRICHMENT_PROVIDER=mock
ABUSEIPDB_API_KEY=
ABUSEIPDB_BASE_URL=https://api.abuseipdb.com/api/v2
ABUSEIPDB_TIMEOUT_MS=8000
ABUSEIPDB_MAX_AGE_DAYS=90
ABUSEIPDB_CACHE_TTL_HOURS=24

# ---------------------------------------------------------------------------
# Phase 5 (AI assistance) — off in tests, as everywhere else by default.
# ---------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=null
